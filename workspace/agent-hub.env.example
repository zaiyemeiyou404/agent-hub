# scripts/agent-hub-init.sh writes workspace/.env with a generated hex password.
DB_PASSWORD=GENERATE_ME
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
WEB_PORT=3000
API_PORT=8000

# Agent runtimes need their own credentials on the machine where they run.
# Enable the coordinator only after choosing a provider, model and server key.
ROUTER_LLM_ENABLED=false
ROUTER_LLM_PROVIDER=openai
ROUTER_LLM_MODEL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_BASE_URL=
COMPLETION_ROUTING_MAX_HANDOFFS=6
